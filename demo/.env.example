# AWS Configuration
# Copy this file to .env and fill in your actual AWS credentials

# Required: Your AWS Access Key ID
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here

# Required: Your AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Optional: AWS Region (defaults to us-east-1 if not specified)
AWS_DEFAULT_REGION=us-east-1

# Optional: S3 Bucket name (defaults to ricardometadata if not specified)
AWS_S3_BUCKET=your_bucket_name_here
